# ==============================================
# MemoraGraph Environment Configuration
# ==============================================
# Copy this file to .env and fill in your values.
# NEVER commit the .env file to version control.
# ==============================================

# --- Application ---
APP_NAME=MemoraGraph
APP_VERSION=0.1.0
DEBUG=true

# --- Backend Server ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# --- PostgreSQL ---
DATABASE_URL=postgresql+asyncpg://memoragraph:memoragraph@localhost:5432/memoragraph

# --- Neo4j ---
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=memoragraph

# --- Qdrant ---
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=organizational_memory

# --- LLM Provider ---
# Supported: openai, google, anthropic, ollama
LLM_PROVIDER=openai
LLM_API_KEY=your-api-key-here
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=2048

# --- Embedding Model ---
# Sentence Transformers model name
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIMENSION=384

# --- JWT Authentication ---
JWT_SECRET=change-this-to-a-random-secret-key
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=1440

# --- File Storage ---
UPLOAD_DIR=./data/documents
PROCESSED_DIR=./data/processed

# --- Logging ---
LOG_LEVEL=INFO
